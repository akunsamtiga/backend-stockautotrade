rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterEmail() {
      return isAuthenticated() && request.auth.token.email == 'zack010591@gmail.com';
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isActive == true;
    }

    function isSuperAdmin() {
      return isAdmin() &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isValidEmail(email) {
      return email is string && email.matches('.*@.*\\..*');
    }

    match /whitelist_users/{docId} {
      allow read: if true;

      allow create: if (isAdmin() || isMasterEmail()) &&
                      request.resource.data.name is string &&
                      request.resource.data.userId is string &&
                      request.resource.data.deviceId is string &&
                      request.resource.data.isActive is bool;

      allow create: if
        request.resource.data.addedBy == "web_registration" &&
        request.resource.data.isActive == true &&
        request.resource.data.name is string &&
        request.resource.data.userId is string &&
        request.resource.data.email is string;

      allow update: if (isAdmin() || isMasterEmail()) &&
                      request.resource.data.name is string &&
                      request.resource.data.userId is string &&
                      request.resource.data.deviceId is string &&
                      request.resource.data.isActive is bool;

      allow update: if
        request.resource.data.name == resource.data.name &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.deviceId == resource.data.deviceId &&
        request.resource.data.isActive == resource.data.isActive;

      allow delete: if isAdmin() || isMasterEmail();
    }

    match /admin_users/{adminId} {
      allow read: if true;

      allow create: if isMasterEmail() &&
                      request.resource.data.email is string &&
                      isValidEmail(request.resource.data.email) &&
                      request.resource.data.name is string &&
                      request.resource.data.role in ['admin', 'super_admin'];

      allow update: if isMasterEmail() ||
                      (isAuthenticated() && request.auth.uid == adminId);

      allow delete: if isMasterEmail();
    }

    match /app_config/{configId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || isMasterEmail();
      allow delete: if isMasterEmail();
    }

    match /security_logs/{logId} {
      allow read: if isAdmin() || isMasterEmail();
      allow create: if true;
      allow update, delete: if false;
    }
  }
}